# Discord Webhooks (REQUIRED)
WEBHOOK_LOW=https://discord.com/api/webhooks/YOUR_LOW_WEBHOOK_ID/YOUR_LOW_WEBHOOK_TOKEN
WEBHOOK_HIGH=https://discord.com/api/webhooks/YOUR_HIGH_WEBHOOK_ID/YOUR_HIGH_WEBHOOK_TOKEN

# Optional: Secret token for authentication
# If set, requests must include header: x-notifier-token
SECRET_TOKEN=your_secret_token_here

# Port (defaults to 3000)
PORT=3000
