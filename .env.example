# Discord Webhook URLs
# Get these from Discord: Server Settings > Integrations > Webhooks
WEBHOOK_LOW=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
WEBHOOK_HIGH=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Secret token for authentication (optional but recommended)
# Generate a strong random string, e.g.: openssl rand -hex 32
# Roblox script must send this in Authorization header or X-Secret-Token header
SECRET_TOKEN=your-secret-token-here

# Port (automatically set by Render, default 3000 for local development)
PORT=3000
